# Copy these settings into .env.local for development or your hosting settings.
# Never commit the filled-in file. Do not copy placeholder credentials verbatim.
AWS_REGION=us-east-1
CONTACT_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:portfolio-contact
CONTACT_TABLE_NAME=ContactMessages
RATE_LIMIT_SECRET=REPLACE_WITH_32_RANDOM_BYTES_ENCODED_AS_HEX
CONTACT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CONTACT_FORM_ENABLED=true
CONTACT_GLOBAL_DAILY_LIMIT=100

# Required in production. Optional locally only when BOTH are absent.
# Use a separate real development widget with localhost allowed to test verification.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_PUBLIC_SITE_KEY
# TURNSTILE_SECRET_KEY=YOUR_PRIVATE_SECRET_KEY

# Vercel supplies its trusted IP header automatically.
# On other hosts, set this ONLY behind a proxy that overwrites this header and
# prevents direct access to the app. Never trust a header clients can supply.
# CONTACT_TRUSTED_IP_HEADER=x-forwarded-for

# Use your existing AWS credential setup (named profile, environment, or role).
# AWS_PROFILE=your-development-profile
